// Careers backend: job applications submitted through the public form,
// plus the admin accounts (HR, and any future content editors) that can
// log in to view them. Deliberately not part of the future site-wide CMS
// (that's a separate, later project) — just enough schema to make the
// Careers application form and its HR-facing inbox real.

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) connection — safe for many concurrent serverless
  // function invocations, but doesn't support the direct/prepared-statement
  // access Migrate needs.
  url       = env("DATABASE_URL")
  // Direct connection, used only by `prisma migrate`/`db push`.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // Just "hr" for now — kept as a plain string rather than an enum so a
  // future CMS role (e.g. "editor") doesn't need a migration to add.
  role         String   @default("hr")
  createdAt    DateTime @default(now())
}

model JobApplication {
  id          String   @id @default(cuid())
  role        String
  fullName    String
  email       String
  phone       String
  coverNote   String?
  resumeName  String
  resumeType  String
  // Resume stored directly in the database rather than a separate file
  // storage service — application volume is low, and this keeps the
  // whole backend to a single portable Postgres database with nothing
  // else to provision, migrate, or reconnect at handover time.
  resumeData  Bytes
  submittedAt DateTime @default(now())
  // Set at submission time to the Payload "job-openings" collection id
  // whose role matched what the applicant selected (Payload owns that
  // collection, not Prisma — so this is a plain int, not a Prisma
  // relation). Null means no currently-published opening matched, i.e.
  // this was a general "no vacancy" resume submission — the Career
  // Portal's Applications page groups by this id; its Resume Submitted
  // page is everything where this is null, sorted by role instead.
  matchedJobOpeningId Int?
}

// Backs the "Role Applied For" dropdown on the public application form —
// managed from the Career Portal's Roles page, ordered by `order`. Kept
// separate from Payload's job-openings collection (see comment above):
// a role can exist here as an evergreen pipeline option with no active
// posting, so the two lists are deliberately not the same thing.
model JobRole {
  id        String   @id @default(cuid())
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
