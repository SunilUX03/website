# Copy this file to .env.local for local development. In production
# (Vercel now, DevOps's own server at handover), set these as real
# environment variables instead of committing a .env file.

# Postgres connection strings. Power the Careers backend (job
# applications + admin/HR login) via Prisma. Both are provisioned
# together by a Postgres integration (this project uses Vercel's Neon
# integration — Vercel dashboard -> Storage -> Create Database) and
# auto-injected as env vars on Vercel; for local dev, pull the same
# values with `vercel env pull .env.local`.
#
# DATABASE_URL is the pooled connection Prisma Client queries through at
# runtime. DATABASE_URL_UNPOOLED is the direct connection Prisma Migrate
# needs (pooled/PgBouncer connections don't support the prepared
# statements migrations require).
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname"

# Signs admin login session tokens. Generate one with:
#   openssl rand -base64 32
# Must be set to the SAME value everywhere this app runs — changing it
# invalidates every existing login session.
AUTH_SECRET="replace-with-a-generated-secret"

# Signs the CMS's own login sessions (Payload, mounted at /cms — a
# completely separate system from the Careers HR login above). Generate
# the same way: openssl rand -base64 32. Uses the same Postgres database
# as everything else (its own tables, no collision with Prisma's).
PAYLOAD_SECRET="replace-with-a-generated-secret"

# Only needed locally to run `npm run cms:migrate:create` / `cms:migrate`
# (the Payload CLI looks here since the config lives under src/, not the
# project root). Not needed at runtime — the app imports the config
# directly via the "@/payload.config" alias.
PAYLOAD_CONFIG_PATH="src/payload.config.ts"

# Where the CMS's Media collection actually stores uploaded files —
# Vercel Blob, not local disk (local disk doesn't persist on Vercel's
# serverless filesystem). Auto-injected on Vercel once a Blob store is
# created and linked to the project (Vercel dashboard -> Storage ->
# Create -> Blob); pull the same value locally with `vercel env pull`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
